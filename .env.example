# ===== Telegram =====
BOT_TOKEN=your_bot_token_here

# v1.1+: owners always have full access.
OWNER_IDS=123456789

# Backwards compatibility with v1.0. IDs here also keep full access.
# Prefer OWNER_IDS + users.json for new installations.
ADMIN_IDS=

# Optional path to the per-user access file.
# Default: <project directory>/users.json
ACCESS_USERS_FILE=./users.json

# ===== Minecraft server process =====
SERVER_DIR=/opt/minecraft

# Recommended: launch your existing script.
SERVER_START_COMMAND=./start.sh

# You can also launch Java directly, for example:
# SERVER_START_COMMAND=java -Xms2G -Xmx6G -jar fabric-server-launch.jar nogui

# PID metadata and stdout/stderr captured by the manager
SERVER_PID_FILE=/opt/minecraft/.telegram-mc-manager.pid
SERVER_OUTPUT_LOG=/opt/minecraft/logs/manager-console.log
SERVER_STOP_TIMEOUT=45

# ===== RCON =====
# Used for console commands and graceful "stop"
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=change_me

# ===== Paths =====
MINECRAFT_LOG_PATH=/opt/minecraft/logs/latest.log
MODS_DIR=/opt/minecraft/mods
WORLD_DIR=/opt/minecraft/world
BACKUP_DIR=/opt/minecraft/backups

# Reject larger Telegram mod uploads
MAX_MOD_UPLOAD_MB=100
