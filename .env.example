# ===== Telegram / global =====
BOT_TOKEN=your_bot_token_here
OWNER_IDS=123456789
ADMIN_IDS=
ACCESS_USERS_FILE=./users.json
AUTO_STOP_STATE_FILE=./auto_stop_state.json
AUTO_BACKUP_STATE_FILE=./auto_backup_state.json
# 0 = disabled unless a server overrides auto_stop_seconds in servers.json.
AUTO_STOP_DEFAULT_SECONDS=0

# ===== Minecraft server registry =====
# All modern servers, including Storm Survival, are declared here.
MINECRAFT_SERVERS_FILE=./servers.json
DEFAULT_SERVER_ID=storm-survival

# Secrets are referenced by rcon_password_env in servers.json.
STORM_SURVIVAL_RCON_PASSWORD=change_me
CREATE_COOP_RCON_PASSWORD=another_secret
# Use a unique rcon_port for every server that may run simultaneously.

# Global upload limit
MAX_MOD_UPLOAD_MB=100

# Filesystem shown by the Telegram "Host" dashboard.
HOST_DISK_PATH=/home

# ===== Legacy single-server fallback (deprecated) =====
# Used only when MINECRAFT_SERVERS_FILE is missing or contains no servers.
# These variables are not merged with a non-empty JSON configuration.
# SERVER_ID=storm-survival
# SERVER_NAME=Storm Survival
# SERVER_DIR=/opt/minecraft
# SERVER_START_COMMAND=./start.sh
# SERVER_PID_FILE=/opt/minecraft/.telegram-mc-manager.pid
# SERVER_OUTPUT_LOG=/opt/minecraft/logs/manager-console.log
# SERVER_STOP_TIMEOUT=45
# MINECRAFT_LOG_PATH=/opt/minecraft/logs/latest.log
# MODS_DIR=/opt/minecraft/mods
# WORLD_DIR=/opt/minecraft/world
# BACKUP_DIR=/opt/minecraft/backups
# RCON_HOST=127.0.0.1
# RCON_PORT=25575
# RCON_PASSWORD=change_me

# ===== Optional external Control API =====
# For bots, AI agents, Open WebUI/Jarvis, automation systems and scripts.
# The Telegram bot and built-in auto-stop work without this API.
CONTROL_API_ENABLED=false
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=8765
# Generate with: openssl rand -hex 32
CONTROL_API_TOKEN=replace_with_a_long_random_token
# Legacy JARVIS_API_* names are still accepted for backwards compatibility.
